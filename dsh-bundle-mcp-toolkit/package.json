{
  "name": "@wjm200509/dsh-bundle-mcp-toolkit",
  "version": "1.2.0",
  "description": "MCP toolkit bundle: CodeGraph plus Context7 with first-use Context7 OAuth sign-in and API-key mode (like npx ctx7 setup)",
  "type": "module",
  "author": "JiaMingWang-CN",
  "license": "MIT",
  "homepage": "https://github.com/JiaMingWang-CN/dsh-bundles#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JiaMingWang-CN/dsh-bundles",
    "directory": "dsh-bundle-mcp-toolkit"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "codegraph",
    "context7",
    "oauth"
  ],
  "files": [
    "lib",
    "patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-alpha.2 || ^0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./patch.yml"
    }
  }
