{
  "name": "@wjm200509/dsh-plugin-version-watch",
  "version": "0.1.4",
  "description": "Version watch for installed DSH plugins: list installed versions, check Git and npm sources for updates, and update them live from Settings without restarting.",
  "type": "module",
  "author": "JiaMingWang-CN",
  "license": "MIT",
  "homepage": "https://github.com/JiaMingWang-CN/dsh-bundles#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JiaMingWang-CN/dsh-bundles",
    "directory": "dsh-plugin-version-watch"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-updates",
    "version-watch"
  ],
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/lockfile.js",
    "lib/spec.js",
    "patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": "^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-alpha.2 || ^0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./patch.yml"
    }
  }
}
